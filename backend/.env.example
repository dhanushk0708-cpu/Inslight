# INSLIGHT Backend Environment Configuration Template
# Copy to .env and fill in strong, unique values before running.

DATABASE_URL=sqlite:///./data/inslight.db
SECRET_KEY=replace-with-a-long-random-hex-secret
ENCRYPTION_KEY=replace-with-a-strong-fernet-seed-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

DATASET_STORAGE_DIR=./data/datasets
REPORT_STORAGE_DIR=./data/reports

GOOGLE_OAUTH_CREDENTIALS_FILE=google-oauth-credentials.json
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_AI_PER_MIN=45
